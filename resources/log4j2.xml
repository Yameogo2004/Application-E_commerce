<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" monitorInterval="30">
    <Properties>
        <Property name="log-path">logs</Property>
        <Property name="pattern">%d{yyyy-MM-dd HH:mm:ss.SSS} [%-5level] %logger{36} - %msg%n</Property>
        <Property name="simple-pattern">%d{HH:mm:ss.SSS} [%-5level] - %msg%n</Property>
    </Properties>

    <Appenders>
        <!-- Console (affichage en temps réel) -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${simple-pattern}"/>
        </Console>

        <!-- Fichier général (tous les logs) -->
        <RollingFile name="AppFile" fileName="${log-path}/app.log"
                     filePattern="${log-path}/archive/app-%d{yyyy-MM-dd}.log.gz">
            <PatternLayout pattern="${pattern}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
            <DefaultRolloverStrategy max="30"/>
        </RollingFile>

        <!-- Fichier des erreurs (seulement erreurs) -->
        <RollingFile name="ErrorFile" fileName="${log-path}/error.log"
                     filePattern="${log-path}/archive/error-%d{yyyy-MM-dd}.log.gz">
            <PatternLayout pattern="${pattern}"/>
            <ThresholdFilter level="ERROR" onMatch="ACCEPT" onMismatch="DENY"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
            </Policies>
        </RollingFile>

        <!-- Logs des paiements (fichier séparé pour audit) -->
        <RollingFile name="PaymentFile" fileName="${log-path}/payment.log"
                     filePattern="${log-path}/archive/payment-%d{yyyy-MM-dd}.log.gz">
            <PatternLayout pattern="${pattern}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
        </RollingFile>

        <!-- Logs des authentifications admin (sécurité) -->
        <RollingFile name="AuthFile" fileName="${log-path}/auth.log"
                     filePattern="${log-path}/archive/auth-%d{yyyy-MM-dd}.log.gz">
            <PatternLayout pattern="${pattern}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
            </Policies>
        </RollingFile>

        <!-- Logs des actions admin -->
        <RollingFile name="AdminFile" fileName="${log-path}/admin.log"
                     filePattern="${log-path}/archive/admin-%d{yyyy-MM-dd}.log.gz">
            <PatternLayout pattern="${pattern}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
            </Policies>
        </RollingFile>
    </Appenders>

    <Loggers>
        <!-- Logger racine (tous les logs sauf les spécifiques) -->
        <Root level="INFO">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="AppFile"/>
            <AppenderRef ref="ErrorFile"/>
        </Root>

        <!-- Logger pour les paiements -->
        <Logger name="com.chrionline.payment" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="PaymentFile"/>
            <AppenderRef ref="ErrorFile"/>
        </Logger>

        <!-- Logger pour les authentifications -->
        <Logger name="com.chrionline.auth" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="AuthFile"/>
            <AppenderRef ref="ErrorFile"/>
        </Logger>

        <!-- Logger pour les actions admin -->
        <Logger name="com.chrionline.admin" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="AdminFile"/>
            <AppenderRef ref="ErrorFile"/>
        </Logger>

        <!-- Logger pour le debug (activable en dev) -->
        <Logger name="com.chrionline.debug" level="DEBUG" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="AppFile"/>
        </Logger>
    </Loggers>
</Configuration>